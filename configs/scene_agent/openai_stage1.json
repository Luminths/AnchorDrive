{
  "model": "gpt-6.1-sol",
  "base_url": "https://api.openai.com/v1",
  "api_key_env": "OPENAI_API_KEY",
  "temperature": 0.6,
  "response_max_tokens": 8192,
  "request_timeout_s": 240,
  "max_requests": 100,
  "max_total_tokens": 500000,
  "max_agent_steps": 45,
  "max_construction_steps": 18,
  "max_controlled_vehicles": 3,
  "max_spawned_vehicles": 3,
  "max_simulation_s": 10.0,
  "decision_interval_s": 2.0,
  "ego_replan_interval_s": 0.5,
  "ego_forecast_horizon_s": 4.0,
  "ego_forecast_sample_interval_s": 0.5,
  "review_reserve_tokens": 24000,
  "topology_assumed_max_speed": 25.0,
  "topology_assumed_acceleration": 25.0,
  "topology_assumed_deceleration": 7.0,
  "dt": 0.1,
  "provider": "openai",
  "enable_thinking": false,
  "planner_model": "gpt-6.1-sol",
  "background_mode": "recorded",
  "ego_model": "idm",
  "compact_final_review": true,
  "reviewer_config": "configs/scene_agent/openai_reviewer.json",
  "posttrial_assessor_max_replans": 2,
  "legacy_parse_max_retries": 1,
