  "max_waypoints": 8,
  "planner_send_bev": true,
  "physical_waypoint_tracking": false,
  "posttrial_failure_policy": "road_validated_fallback",
  "posttrial_check_road": false,
  "planner_thinking": false,
  "planner_response_max_tokens": 8192,
  "validation_max_abs_yaw_rate_rps": 1.0,
  "posttrial_allow_rejected_fallback": true,
  "reasoning_effort": "low",
  "execution_mode": "native_trial_waypoint_assessor",
  "anchor_horizon_s": 3.0,
  "ego_plan_horizon_s": 3.0,
  "legacy_assessor_max_replans": 1,
  "legacy_send_bev": true,
  "lightweight_native_steps": true
}
